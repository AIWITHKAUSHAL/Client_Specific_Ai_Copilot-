# ---------------------------------------------------------------------------
# Logistics Operations Copilot - example environment file
#
# Copy to .env and adjust per environment. Every value has a safe default,
# so the prototype runs with no .env file at all:  python app.py
#
# NEVER commit a real .env. Production values belong in a secrets manager
# (AWS Secrets Manager / Azure Key Vault / HashiCorp Vault) - see docs/security.md.
# ---------------------------------------------------------------------------

# --- Application ---
COPILOT_CLIENT_NAME=Demo Logistics Pvt. Ltd.
COPILOT_ENV=local
COPILOT_LOG_LEVEL=INFO
COPILOT_LOG_DIR=logs
COPILOT_LOG_FILE=copilot.log

# --- Agent ---
# rule_based (default, deterministic, no external calls) | llm (future)
COPILOT_AGENT_MODE=rule_based
COPILOT_SHIPMENT_ID_PATTERN=\b([A-Za-z]{2,4}-?\d{3,8})\b

# --- Pricing / escalation ---
COPILOT_CURRENCY=USD
COPILOT_ESCALATION_PREFIX=ESC
COPILOT_ESCALATION_QUEUE=operations-team

# --- API ---
COPILOT_API_HOST=0.0.0.0
COPILOT_API_PORT=8000
COPILOT_MAX_QUERY_LENGTH=500

# ---------------------------------------------------------------------------
# NOT used by this prototype - shown as the shape of a client deployment.
# ---------------------------------------------------------------------------
# TMS_API_BASE_URL=https://tms.client.example.com/api/v1
# TMS_API_TOKEN=
# HELPDESK_BASE_URL=https://client.service-now.com/api
# HELPDESK_API_TOKEN=
# DATABASE_URL=postgresql://copilot:password@localhost:5432/copilot
# OIDC_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0
# OIDC_AUDIENCE=logistics-copilot
